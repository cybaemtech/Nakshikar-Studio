# Apache .htaccess configuration for React SPA on cPanel Hosting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable MultiViews to prevent automatic content negotiation matching
  Options -MultiViews

  # Force 301 Redirect: HTTP / www -> https://nakshikarsstudio.com/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://nakshikarsstudio.com/$1 [R=301,L]

  # Route /api/send-email (with optional trailing slash) directly to the PHP script
  RewriteRule ^api/send-email/?$ /api/send-email.php [L]

  # 301 Redirects for /work?category=... query param URLs
  RewriteCond %{QUERY_STRING} ^category=(Graphics|graphics)$ [NC]
  RewriteRule ^work/?$ /work/graphics? [R=301,L]

  RewriteCond %{QUERY_STRING} ^category=(Wall%20Design|wall-design)$ [NC]
  RewriteRule ^work/?$ /work/wall-design? [R=301,L]

  RewriteCond %{QUERY_STRING} ^category=(Paintings|paintings)$ [NC]
  RewriteRule ^work/?$ /work/paintings? [R=301,L]

  RewriteCond %{QUERY_STRING} ^category=(Murals|murals)$ [NC]
  RewriteRule ^work/?$ /work/murals? [R=301,L]

  RewriteCond %{QUERY_STRING} ^category=(Nameplates|nameplates)$ [NC]
  RewriteRule ^work/?$ /work/nameplates? [R=301,L]

  RewriteCond %{QUERY_STRING} ^category=(Interior%20Support|interior-support)$ [NC]
  RewriteRule ^work/?$ /work/interior-support? [R=301,L]

  # Allow direct access to existing static files, images, and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to index.html for TanStack Router / React SPA
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP Compression for ultra-fast asset loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Enable Leverage Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 day"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
